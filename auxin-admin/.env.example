# ─────────────────────────────────────────────────────────────────────────────
# Auxin Admin Portal — .env.example
# Copy this to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# See: docs/architecture/environment_variables.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────────────────────
# Local dev:   http://localhost:8000/api/v1
# Production:  https://api.auxin.in/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find in Supabase Dashboard → Project → Settings → API
# Must match the SAME Supabase project as the frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── App Environment ───────────────────────────────────────────────────────────
# Values: development | production
NEXT_PUBLIC_APP_ENV=development

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# true  = Show amber banner: "DEMO MODE — Sandbox data only"
# false = Normal production mode
NEXT_PUBLIC_DEMO_MODE=false

# ── Admin Portal URL ─────────────────────────────────────────────────────────
# Local: http://localhost:3001
# Production: https://admin.auxin.in
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Razorpay (display only — admin never initiates payments) ─────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
