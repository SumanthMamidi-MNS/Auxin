# ─────────────────────────────────────────────────────────────────────────────
# Auxin Backend — .env.example
# ─────────────────────────────────────────────────────────────────────────────
# SAFE TEMPLATE — copy to .env.development and fill in real values.
# This file contains ONLY placeholder values. Never put real secrets here.
# Full variable reference: docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true                    # MUST be false in production (enables /docs and verbose errors)

# Comma-separated list of allowed CORS origins (no trailing slashes).
# "*" is ignored when APP_ENV=production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=DEBUG

# ── Database ─────────────────────────────────────────────────────────────────
# LOCAL DEFAULT: a SQLite file next to the project. No account or network needed.
DATABASE_URL=sqlite+aiosqlite:///auxin.db

# HOSTED (Supabase Postgres) — use the SESSION pooler string, port 5432:
# DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase Auth (needed for sign-in; login requires internet) ──────────────
# Find all three in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_JWT_SECRET

# ── Bootstrap super admin ────────────────────────────────────────────────────
# The ONLY account that may self-register with role=admin: its verified login
# email must equal this value. Every other admin is created by a super admin.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PHONE=+910000000000
SUPER_ADMIN_PASSWORD=

# ── Demo sandbox ─────────────────────────────────────────────────────────────
# DEMO_MODE=true routes ALL database access to DEMO_DATABASE_URL.
DEMO_MODE=false
DEMO_DATABASE_URL=

# ── Security ─────────────────────────────────────────────────────────────────
# Fernet key for bank account number encryption at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ACCOUNT_ENCRYPTION_KEY=

# ── Delivery ─────────────────────────────────────────────────────────────────
DELIVERY_OTP_EXPIRY_MINUTES=10
DELIVERY_GEOFENCE_RADIUS_METERS=100.0

# ── Razorpay (leave blank to disable online payments; COD still works) ───────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_SECRET=REPLACE_WITH_RAZORPAY_SECRET

# ── Milo AI (separate service, started by start.bat) ─────────────────────────
MILO_BACKEND_URL=http://127.0.0.1:8001
