# ─────────────────────────────────────────────────────────────────────────────
# Auxin Frontend — .env.example
# Copy this to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# See: docs/architecture/environment_variables.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────────────────────
# Local dev:   http://localhost:8000/api/v1
# Production:  https://api.auxin.in/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find in Supabase Dashboard → Project → Settings → API
# Project URL (looks like: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Anon/Public key (safe to expose to browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── App Environment ───────────────────────────────────────────────────────────
# Values: development | production
NEXT_PUBLIC_APP_ENV=development

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# true  = Show investor demo amber banner; backend routes to sandbox DB
# false = Normal production mode
NEXT_PUBLIC_DEMO_MODE=false

# ── Portal URLs ───────────────────────────────────────────────────────────────
# URL of the admin portal (for redirecting admin users)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Full canonical URL of this app (for SEO/OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Razorpay ──────────────────────────────────────────────────────────────────
# PUBLIC key only — the secret NEVER touches the frontend
# Test:       rzp_test_XXXXXXXXXXXXXXXX
# Production: rzp_live_XXXXXXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# ── Demo sign-in (OFF unless NEXT_PUBLIC_DEMO_MODE=true) ─────────────────────
# Enables the one-click Customer / Farmer / Courier demo buttons. These are
# throw-away sandbox accounts; the password is public by nature, so only turn
# this on for a sandbox/demo deployment backed by DEMO_DATABASE_URL.
# NEXT_PUBLIC_DEMO_PASSWORD=choose-a-demo-password

# ── Local-development shortcut accounts (only active under `next dev`) ───────
# NEXT_PUBLIC_DEV_TEST_EMAILS=dev1@example.com,dev2@example.com
# NEXT_PUBLIC_DEV_TEST_PASSWORD=choose-a-dev-password
