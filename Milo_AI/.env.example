# Milo AI — .env.example (copy to Milo_AI/.env.development). Placeholders only.
APP_ENV=development
DEBUG=false

# Generative answers (optional; without a key Milo answers from retrieved knowledge only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hosted knowledge store (optional; without these Milo uses the local curated index)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Must equal MILO_SHARED_SECRET on the Core API. Empty = open (local 127.0.0.1 only).
MILO_SHARED_SECRET=
